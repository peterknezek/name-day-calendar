{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"],
}
